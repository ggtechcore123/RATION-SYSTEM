rules_version = '2';
// ==============================================================================
// Firebase Cloud Firestore Security Rules
// Project: ration-system-877e4
// Application: Smart Indian Public Distribution System (PDS)
// ==============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.uid == 'admin_master'
      );
    }

    function isOfficer() {
      return isAuthenticated() && (
        request.auth.token.role == 'officer' ||
        isAdmin()
      );
    }

    function isAssignedOfficer(officeId) {
      return isAdmin() || (
        isOfficer() &&
        request.auth.token.assignedOfficeId == officeId
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();
    }

    // 2. Beneficiary Customers Collection
    match /customers/{customerId} {
      // Allow public registration but strictly enforce initial status to 'PENDING'
      allow create: if request.resource.data.status == 'PENDING';
      // Beneficiaries can read their own profile; Officers & Admins can read all
      allow read: if isAuthenticated();
      // Only Admins can approve (status -> APPROVED) or reject applications
      allow update: if isAdmin() || (
        isOfficer() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastDistributedAt', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // 3. Family Members Collection
    match /familyMembers/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isOfficer();
    }

    // 4. Fingerprint Template References (Only protected non-reversible hash refs)
    match /fingerprintReferences/{refId} {
      allow read, write: if isOfficer() || isAdmin();
    }

    // 5. Ration Cards Registry
    match /rationCards/{cardNo} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 6. Fair Price Offices Collection
    match /offices/{officeId} {
      allow read: if true; // Public directory for citizens to locate their FPS
      allow write: if isAdmin();
    }

    // 7. FPS Officers Collection
    match /officers/{officerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 8. Warehouses & Grain Silos
    match /warehouses/{warehouseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 9. Commodities Schedule
    match /commodities/{commodityId} {
      allow read: if true; // Public view for subsidized grain prices
      allow write: if isAdmin();
    }

    // 10. Grain Stock Batches
    match /stockBatches/{batchId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 11. Warehouse Inventory
    match /warehouseInventory/{invId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 12. Office Inventory
    match /officeInventory/{officeId} {
      allow read: if isAuthenticated();
      allow write: if isAssignedOfficer(officeId);
    }

    // 13. Grain Dispatches
    match /dispatches/{dispatchId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() || isAssignedOfficer(resource.data.destinationOfficeId);
      allow delete: if false; // Dispatches are immutable audit records
    }

    // 14. Dispatch Items
    match /dispatchItems/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 15. Receipts Collection
    match /receipts/{receiptId} {
      allow read: if isAuthenticated();
      allow create: if isOfficer();
      allow update, delete: if false;
    }

    // 16. Entitlements Rules Schedule
    match /entitlements/{entitlementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 17. Citizen Distributions (Immutable Ledger Mirror)
    match /distributions/{distId} {
      allow read: if isAuthenticated();
      allow create: if isOfficer();
      allow update, delete: if false; // Strict immutability for distribution logs
    }

    // 18. Blockchain Mirror Records
    match /blockchainTransactions/{txId} {
      allow read: if true; // Public auditability
      allow write: if false; // Server-side admin only
    }

    // 19. Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 20. Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Append-only by server
    }

    // 21. IoT Device Registry
    match /deviceRegistry/{deviceId} {
      allow read, write: if isAdmin();
    }

    // 22. System Settings
    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
